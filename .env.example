# .env.example
# ==============================================================================
# PRIMARY DEPLOYMENT (Render / Unified Node Full-Stack)
# Zero mandatory GCP Project ID requirement.
# ==============================================================================
NODE_ENV=production
API_PROVIDER=gemini
GEMINI_API_KEY=

# Ollama Fallback Configuration (Optional for local testing)
OLLAMA_BASE_URL=http://localhost:11434

# ==============================================================================
# OPTIONAL: Google Cloud Platform (Only if using GCP Secret Manager / Cloud Run)
# ==============================================================================
GOOGLE_CLOUD_PROJECT=

# ==============================================================================
# Client Firebase Configuration (Optional — Falls back to Sandbox Mode if omitted)
# ==============================================================================
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

